# AI Model Configuration
# Supported providers: gemini, openai, anthropic, or demo
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
# If AI_API_KEY is empty, the application automatically runs in explicit DEMO/FALLBACK mode with sample-aware extraction.

# High Value Threshold (in local currency, e.g., INR)
HIGH_VALUE_THRESHOLD=100000.0

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./invoices.db
# For PostgreSQL: postgresql://user:password@localhost:5432/invoice_db

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_SIZE_MB=15

# Tesseract OCR path (optional on Windows if not in PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Optional Alert / Notification Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=admin@example.com

# Optional Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
